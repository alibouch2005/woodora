{% extends 'base.html.twig' %}


{% block title %}
    {{ category.name }} | Woodora
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/products.css') }}">
{% endblock %}



{% block body %}


<section class="products-page">


    <div class="products-header">

        <span class="products-label">
            WOODORA COLLECTION
        </span>

        <h1>
            {{ category.name }}
        </h1>

        <p>
            Discover our {{ category.name|lower }} furniture collection.
        </p>

    </div>



    <div class="products-container">


        {% for product in products %}


            <article class="product-card">


                <div class="product-image">

                    <img
                        src="{{ asset('images/products/' ~ product.image) }}"
                        alt="{{ product.name }}"
                        onerror="this.onerror=null; this.src='{{ asset('images/categories/' ~ category.image) }}';"
                    >

                </div>



                <div class="product-info">


                    <h3>
                        {{ product.name }}
                    </h3>


                    <p class="product-description">
                        {{ product.description }}
                    </p>


                    <div class="product-bottom">


                        <span class="product-price">
                            {{ product.price|number_format(2, ',', ' ') }} DH
                        </span>


                        <a href="#" class="product-button">
                            View Product
                        </a>


                    </div>


                </div>


            </article>


        {% else %}


            <p class="no-products">
                No products available in this category.
            </p>


        {% endfor %}


    </div>


</section>


{% endblock %}
